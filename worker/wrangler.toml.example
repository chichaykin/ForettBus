name = "forett-shuttle-api"
main = "src/index.ts"
compatibility_date = "2026-09-18"
workers_dev = true

# Set secrets after creating the Worker; never put their values in this file.
#   npx wrangler secret put LTA_ACCOUNT_KEY
#   npx wrangler secret put APP_API_KEY
#   npx wrangler secret put APP_API_KEY_PREVIOUS
#   npx wrangler secret put ONEMAP_TOKEN
